{
  "routes": [
    {
      "route": "/privacidad",
      "rewrite": "/privacidad.html"
    },
    {
      "route": "/terminos",
      "rewrite": "/terminos.html"
    },
    {
      "route": "/css/*",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "route": "/js/*",
      "headers": {
        "cache-control": "public, max-age=86400"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "anonymous"
      ]
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  }
}